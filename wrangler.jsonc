// Cloudflare Workers: publishes the web version of the app.
// `npx wrangler deploy` builds the site into ./dist (see "build" below) and
// uploads that folder.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "language-gym",
	"compatibility_date": "2026-11-17",
	// Build the site as part of `wrangler deploy`, so publishing works even
	// when no separate build command is set in the Cloudflare dashboard.
	"build": {
		"command": "npx expo export --platform web"
	},
	"assets": {
		"directory": "./dist",
		// The app is a single page: any address (such as /session/123456)
		// serves index.html, and the app works out which screen to show.
		"not_found_handling": "single-page-application"
	}
}
